# GEMINI_API_KEY: Required for Gemini AI API calls and Shawn Live when using the Node backend.
# Keep this secret out of source control. Configure it in the deployment provider's secret/env settings.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_CLIENT_ID: Your Google OAuth Client ID for Drive integration
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GROQ_API_KEY=
OLLAMA_API_URL=

# Optional: public HTTP/HTTPS base URL of the separate Node/WebSocket backend.
# Example: https://hub-mind-backend.example.com
VITE_API_BASE_URL=

# Optional: explicit Shawn Live WebSocket base URL.
# If omitted, the client derives a WebSocket URL from VITE_API_BASE_URL/current host.
# Example: wss://hub-mind-backend.example.com
VITE_SHAWN_LIVE_WS_URL=
