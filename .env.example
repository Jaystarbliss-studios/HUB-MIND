# =============================================================================
# REQUIRED FOR NETLIFY DEPLOYMENT & PRODUCTION ASSISTANT (JESS)
# =============================================================================
# Gemini server credential. NEVER expose this to the browser.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Firebase browser configuration. Keep values out of source control.
# Firebase Web API keys are public browser configuration, not authorization secrets.
FIREBASE_WEB_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
FIRESTORE_DATABASE_ID="YOUR_FIRESTORE_DATABASE_ID"
FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_PROJECT_ID.firebaseapp.com"
FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_PROJECT_ID.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"

# Google Calendar & Drive OAuth Client ID (browser-side public configuration)
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"

APP_URL="https://your-site.netlify.app"

# Server-only Google OAuth credentials. NEVER use the VITE_ prefix for these.
# GOOGLE_CLIENT_ID may reuse the same OAuth client ID as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
# Long random server-only secret used to sign OAuth state and encrypt refresh tokens at rest.
GOOGLE_OAUTH_SECRET="YOUR_LONG_RANDOM_OAUTH_SECRET"
# Optional; if omitted Hub-Mind derives this from APP_URL.
GOOGLE_OAUTH_REDIRECT_URI="https://your-site.netlify.app/api/google-oauth-callback"
