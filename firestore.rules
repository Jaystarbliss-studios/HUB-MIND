rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdminOrAssistant() {
      return isSignedIn() && (
        request.auth.token.email == 'johnrufai242@gmail.com' ||
        (hasUserDoc() && (getUserDoc().role == 'admin' || getUserDoc().role == 'assistant'))
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'johnrufai242@gmail.com' ||
        (hasUserDoc() && getUserDoc().role == 'admin')
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || 
        request.auth.uid == userId ||
        request.auth.token.email == 'johnrufai242@gmail.com'
      );
      allow delete: if isAdmin();

      // Nested user conversations (Persistent conversation history with Shawn)
      match /conversations/{conversationId} {
        allow read, write: if isSignedIn();
      }

      // User private subcollection (quick notes, settings)
      match /private/{document=**} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // Direct conversations collection (fallback if queried at root level)
    match /conversations/{conversationId} {
      allow read, write: if isSignedIn();
    }

    // Tasks Collection
    match /tasks/{taskId} {
      allow read, write: if isSignedIn();
    }

    // Documents Collection
    match /documents/{documentId} {
      allow read, write: if isSignedIn();
    }

    // Projects Collection
    match /projects/{projectId} {
      allow read, write: if isSignedIn();
    }

    // Clients Collection
    match /clients/{clientId} {
      allow read, write: if isSignedIn();
    }

    // Meetings Collection
    match /meetings/{meetingId} {
      allow read, write: if isSignedIn();
    }

    // Inbox Collection (Quick Capture)
    match /inbox/{inboxId} {
      allow read, write: if isSignedIn();
    }

    // Knowledge Base
    match /knowledge/{knowledgeId} {
      allow read, write: if isSignedIn();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if isSignedIn();
    }

    // Activity Logs & Audit Trails
    match /activityLogs/{activityId} {
      allow read, write: if isSignedIn();
    }

    match /activity/{activityId} {
      allow read, write: if isSignedIn();
    }

    // Recurring Task Templates
    match /recurringTaskTemplates/{templateId} {
      allow read, write: if isSignedIn();
    }

    // Agent Memories
    match /memories/{memoryId} {
      allow read, write: if isSignedIn();
    }
  }
}

