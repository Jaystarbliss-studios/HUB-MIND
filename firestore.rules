rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      let data = exists(/databases/$(database)/documents/users/$(request.auth.uid))
         ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
         : null;
      return data != null ? data : (
         exists(/databases/$(database)/documents/users/$(request.auth.token.email))
         ? get(/databases/$(database)/documents/users/$(request.auth.token.email)).data
         : null
      );
    }
    
    function getRole() {
      let data = getUserData();
      return data != null ? data.role : null;
    }
    
    function isAdmin() {
      return isSignedIn() && getRole() == 'admin';
    }
    
    function isAssistant() {
      return isSignedIn() && getRole() == 'assistant';
    }
    
    function isStaffOrTeacher() {
      return isSignedIn() && (getRole() == 'teacher' || getRole() == 'staff');
    }
    
    function isOwner(userId) {
      return isSignedIn() && (request.auth.uid == userId || request.auth.token.email == userId);
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      // User can read their own doc, admin can read any
      allow read: if isOwner(userId) || isAdmin();
      // Only admin can create or delete users
      allow create: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
      // User can update their own doc EXCEPT the role field, admin can update any
      allow update: if isAdmin() || (
        isOwner(userId) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
      );
      
      match /private/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Clients Collection
    match /clients/{clientId} {
      allow read, write: if isSignedIn();
    }

    // Tasks Collection
    match /tasks/{taskId} {
      allow read, write: if isSignedIn();
    }

    // Meetings Collection
    match /meetings/{meetingId} {
      allow read, write: if isSignedIn();
    }

    // Documents Collection
    match /documents/{docId} {
      allow read: if isAdmin() || isAssistant() || isStaffOrTeacher();
      allow write: if isAdmin() || isAssistant();
    }

    // Notifications Collection
    match /notifications/{notifId} {
      allow read, write: if isOwner(resource.data.userId) || (
        // For creation, check incoming data
        request.method == 'create' && isOwner(request.resource.data.userId)
      ) || isAdmin(); // Allow admins to create notifications for others
    }

    // Finance Collection
    match /finance/{entryId} {
      allow read, write: if isAdmin();
    }
    // Inbox Collection
    match /inbox/{itemId} {
      allow read, write: if isSignedIn();
    }

    // Recurring Task Templates Collection
    match /recurringTaskTemplates/{templateId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin() || isAssistant();
      allow update: if isAdmin() || isAssistant() || (
        isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastGeneratedDate'])
      );
    }

    // Activity Logs Collection
    match /activityLogs/{logId} {
      allow read, write: if isSignedIn();
    }
  }
}

