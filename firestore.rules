rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function hasUserDoc(uid) {
      return signedIn() && exists(/databases/$(database)/documents/users/$(uid));
    }

    function roleIs(role) {
      return signedIn() && hasUserDoc(request.auth.uid) && userDoc(request.auth.uid).role == role;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == 'johnrufai242@gmail.com' ||
        roleIs('admin')
      );
    }

    function isWorkspaceUser() {
      return signedIn() && hasUserDoc(request.auth.uid) && userDoc(request.auth.uid).status != 'inactive';
    }

    function isAssistantOrAdmin() {
      return isAdmin() || (isWorkspaceUser() && roleIs('assistant'));
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isOwner(field) {
      return signedIn() && field == request.auth.uid;
    }

    // Secure by default.
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      // A user can read their own profile. Admins/assistants can manage the team.
      allow read: if isSelf(userId) || isAssistantOrAdmin();
      allow create: if isSelf(userId) || isAdmin();
      allow update: if isSelf(userId) || isAssistantOrAdmin();
      allow delete: if isAdmin();

      match /conversations/{conversationId} {
        allow read, write: if isSelf(userId) || isAssistantOrAdmin();
      }

      match /private/{document=**} {
        allow read, write: if isSelf(userId) || isAdmin();
      }
    }

    // Legacy/root conversation fallback. Keep it restricted.
    match /conversations/{conversationId} {
      allow read, write: if isAssistantOrAdmin();
    }

    match /tasks/{taskId} {
      allow read: if isAssistantOrAdmin()
        || (isWorkspaceUser() && (
          resource.data.assignedTo == request.auth.uid ||
          resource.data.createdBy == request.auth.uid
        ));
      allow create: if isAssistantOrAdmin()
        || (isWorkspaceUser() && request.resource.data.createdBy == request.auth.uid);
      allow update: if isAssistantOrAdmin()
        || (isWorkspaceUser() && (
          resource.data.assignedTo == request.auth.uid ||
          resource.data.createdBy == request.auth.uid
        ));
      allow delete: if isAssistantOrAdmin()
        || (isWorkspaceUser() && resource.data.createdBy == request.auth.uid);
    }

    match /documents/{documentId} {
      allow read: if isAssistantOrAdmin()
        || (isWorkspaceUser() && resource.data.ownerId == request.auth.uid);
      allow create: if isAssistantOrAdmin()
        || (isWorkspaceUser() && request.resource.data.ownerId == request.auth.uid);
      allow update: if isAssistantOrAdmin()
        || (isWorkspaceUser() && resource.data.ownerId == request.auth.uid);
      allow delete: if isAssistantOrAdmin()
        || (isWorkspaceUser() && resource.data.ownerId == request.auth.uid);

      match /versions/{versionId} {
        allow read, write: if isAssistantOrAdmin()
          || (isWorkspaceUser() && get(/databases/$(database)/documents/documents/$(documentId)).data.ownerId == request.auth.uid);
      }
    }

    match /projects/{projectId} {
      allow read: if isAssistantOrAdmin()
        || (isWorkspaceUser() && resource.data.ownerId == request.auth.uid);
      allow create: if isAssistantOrAdmin()
        || (isWorkspaceUser() && request.resource.data.ownerId == request.auth.uid);
      allow update, delete: if isAssistantOrAdmin()
        || (isWorkspaceUser() && resource.data.ownerId == request.auth.uid);
    }

    match /clients/{clientId} {
      allow read: if isAssistantOrAdmin()
        || (isWorkspaceUser() && resource.data.ownerId == request.auth.uid);
      allow create: if isAssistantOrAdmin()
        || (isWorkspaceUser() && request.resource.data.ownerId == request.auth.uid);
      allow update, delete: if isAssistantOrAdmin()
        || (isWorkspaceUser() && resource.data.ownerId == request.auth.uid);
    }

    match /meetings/{meetingId} {
      allow read: if isAssistantOrAdmin()
        || (isWorkspaceUser() && resource.data.ownerId == request.auth.uid);
      allow create: if isAssistantOrAdmin()
        || (isWorkspaceUser() && request.resource.data.ownerId == request.auth.uid);
      allow update, delete: if isAssistantOrAdmin()
        || (isWorkspaceUser() && resource.data.ownerId == request.auth.uid);
    }

    match /inbox/{inboxId} {
      allow read: if isAssistantOrAdmin()
        || (isWorkspaceUser() && resource.data.createdBy == request.auth.uid);
      allow create: if isWorkspaceUser() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAssistantOrAdmin()
        || (isWorkspaceUser() && resource.data.createdBy == request.auth.uid);
    }

    match /followUps/{followUpId} {
      allow read: if isAssistantOrAdmin()
        || (isWorkspaceUser() && resource.data.ownerId == request.auth.uid);
      allow create: if isAssistantOrAdmin()
        || (isWorkspaceUser() && request.resource.data.ownerId == request.auth.uid);
      allow update, delete: if isAssistantOrAdmin()
        || (isWorkspaceUser() && resource.data.ownerId == request.auth.uid);
    }

    match /knowledge/{knowledgeId} {
      allow read: if isAssistantOrAdmin()
        || (isWorkspaceUser() && resource.data.createdBy == request.auth.uid);
      allow create: if isAssistantOrAdmin()
        || (isWorkspaceUser() && request.resource.data.createdBy == request.auth.uid);
      allow update, delete: if isAssistantOrAdmin()
        || (isWorkspaceUser() && resource.data.createdBy == request.auth.uid);
    }

    match /notifications/{notificationId} {
      allow read: if isWorkspaceUser() && resource.data.userId == request.auth.uid;
      allow create: if isAssistantOrAdmin()
        || (isWorkspaceUser() && request.resource.data.userId == request.auth.uid);
      allow update: if isWorkspaceUser() && resource.data.userId == request.auth.uid;
      allow delete: if isAssistantOrAdmin()
        || (isWorkspaceUser() && resource.data.userId == request.auth.uid);
    }


    // Read-only deep-link snapshots. These are created only by workspace operators and
    // contain a deliberate copy of the item intended for sharing, not editable records.
    match /sharedRecords/{shareId} {
      allow read: if isWorkspaceUser();
      allow create: if isAssistantOrAdmin();
      allow update, delete: if isAssistantOrAdmin();
    }

    match /activityLogs/{activityId} {
      allow read: if isAssistantOrAdmin();
      allow create: if isWorkspaceUser() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /activity/{activityId} {
      allow read: if isAssistantOrAdmin();
      allow create: if isWorkspaceUser();
      allow update, delete: if isAdmin();
    }

    match /recurringTaskTemplates/{templateId} {
      allow read: if isAssistantOrAdmin();
      allow create, update, delete: if isAssistantOrAdmin();
    }

    match /memories/{memoryId} {
      // Memories are private unless deliberately managed by an admin/assistant.
      allow read: if isAssistantOrAdmin()
        || (isWorkspaceUser() && resource.data.userId == request.auth.uid);
      allow create: if isAssistantOrAdmin()
        || (isWorkspaceUser() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAssistantOrAdmin()
        || (isWorkspaceUser() && resource.data.userId == request.auth.uid);
    }
  }
}
