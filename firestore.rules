rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStaff() {
      return isSignedIn() && (getUserDoc().role == 'staff' || getUserDoc().role == 'teacher');
    }

    function isAdminOrAssistant() {
      return isSignedIn() && (
        getUserDoc().role == 'admin' || 
        getUserDoc().role == 'assistant' ||
        request.auth.token.email == 'johnrufai242@gmail.com'
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        getUserDoc().role == 'admin' || 
        request.auth.token.email == 'johnrufai242@gmail.com'
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      // Allow user to set/update their profile fields (like preferredName, photoUrl, phone)
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdminOrAssistant());
      allow update: if isSignedIn() && (
        isAdmin() || 
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
      );
      allow delete: if isAdmin();

      // Nested user conversations (Persistent conversation history with Shawn)
      match /conversations/{conversationId} {
        allow read, write: if isOwner(userId) || isAdminOrAssistant();
      }
    }

    // Direct conversations collection (fallback if queried at root level with userId)
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdminOrAssistant());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdminOrAssistant());
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdminOrAssistant());
    }

    // Tasks Collection
    match /tasks/{taskId} {
      allow read: if isSignedIn() && (
        isAdminOrAssistant() || 
        resource.data.assignedTo == request.auth.uid || 
        resource.data.createdBy == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdminOrAssistant() || 
        resource.data.assignedTo == request.auth.uid || 
        resource.data.createdBy == request.auth.uid
      );
      allow delete: if isAdminOrAssistant() || (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    // Documents Collection
    match /documents/{documentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdminOrAssistant() || 
        resource.data.createdBy == request.auth.uid ||
        resource.data.ownerId == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        isAdminOrAssistant() || 
        resource.data.createdBy == request.auth.uid ||
        resource.data.ownerId == request.auth.uid
      );
    }

    // Projects Collection
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdminOrAssistant() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    // Clients Collection
    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdminOrAssistant();
    }

    // Meetings Collection
    match /meetings/{meetingId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdminOrAssistant() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    // Inbox Collection (Quick Capture)
    match /inbox/{inboxId} {
      allow read: if isSignedIn() && (isAdminOrAssistant() || resource.data.createdBy == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (isAdminOrAssistant() || resource.data.createdBy == request.auth.uid);
    }

    // Knowledge Base
    match /knowledge/{knowledgeId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdminOrAssistant();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdminOrAssistant());
      allow create: if isSignedIn();
    }

    // Activity Logs & Memories
    match /activity/{activityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    match /memories/{memoryId} {
      allow read, write: if isSignedIn();
    }
  }
}
