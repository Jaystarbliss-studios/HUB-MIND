rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function hasUserDoc(uid) { return signedIn() && exists(/databases/$(database)/documents/users/$(uid)); }
    function isAdmin() { 
      return signedIn() && (
        request.auth.token.email == 'johnrufai242@gmail.com' || 
        (hasUserDoc(request.auth.uid) && userDoc(request.auth.uid).role == 'admin')
      ); 
    }
    function isWorkspaceUser() { 
      return signedIn() && (
        isAdmin() || 
        (hasUserDoc(request.auth.uid) && userDoc(request.auth.uid).status == 'active')
      ); 
    }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    function isOwner(data) { 
      return isWorkspaceUser() && (
        (data.keys().hasAny(['ownerId']) && data.ownerId == request.auth.uid) || 
        (data.keys().hasAny(['createdBy']) && data.createdBy == request.auth.uid)
      ); 
    }

    function hasReadAccess(data) {
      return isAdmin() || (
        isWorkspaceUser() && (
          isOwner(data) ||
          (!data.keys().hasAny(['visibility']) || data.visibility == 'workspace') ||
          (data.keys().hasAny(['visibility']) && data.visibility == 'shared' && data.keys().hasAny(['sharedWith']) && request.auth.uid in data.sharedWith) ||
          (data.keys().hasAny(['assignedTo']) && data.assignedTo == request.auth.uid)
        )
      );
    }

    function hasWriteAccess(data) {
      return isAdmin() || (
        isWorkspaceUser() && (
          isOwner(data) ||
          (data.keys().hasAny(['permissions']) && data.permissions.keys().hasAny([request.auth.uid]) && data.permissions[request.auth.uid] == 'write')
        )
      );
    }

    match /{document=**} { allow read, write: if false; }

    // Users Collection
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (isSelf(userId) && request.resource.data.role == 'staff' && request.resource.data.status == 'active');
      allow update: if isAdmin() || (isSelf(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['preferredName', 'displayName', 'photoUrl', 'phone', 'defaultVisibility', 'username', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // Invitations Collection
    match /invitations/{invitationId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt', 'acceptedByUid', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // Connections (People) Collection
    match /connections/{connectionId} {
      allow read: if signedIn() && (
        isAdmin() || 
        resource == null || 
        resource.data.requesterId == request.auth.uid || 
        resource.data.recipientId == request.auth.uid
      );
      allow create: if signedIn() && (
        isAdmin() || 
        request.resource.data.requesterId == request.auth.uid
      );
      allow update: if signedIn() && (
        isAdmin() || 
        resource.data.recipientId == request.auth.uid || 
        resource.data.requesterId == request.auth.uid
      );
      allow delete: if signedIn() && (
        isAdmin() || 
        resource.data.requesterId == request.auth.uid || 
        resource.data.recipientId == request.auth.uid
      );
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read, write: if signedIn();
    }

    // Unified Resource Shares Collection
    match /shares/{shareId} {
      allow read: if isWorkspaceUser();
      allow create: if isWorkspaceUser() && (request.resource.data.ownerId == request.auth.uid || isAdmin());
      allow update, delete: if isWorkspaceUser() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Documents & Versions
    match /documents/{documentId} {
      allow read: if hasReadAccess(resource.data);
      allow create: if isWorkspaceUser() && request.resource.data.ownerId == request.auth.uid;
      allow update: if hasWriteAccess(resource.data);
      allow delete: if isAdmin() || (isWorkspaceUser() && (resource.data.ownerId == request.auth.uid || resource.data.createdBy == request.auth.uid));

      match /versions/{versionId} {
        allow read: if isWorkspaceUser();
        allow create, update: if isWorkspaceUser();
        allow delete: if isAdmin();
      }
    }

    // Tasks Collection
    match /tasks/{taskId} {
      allow read: if hasReadAccess(resource.data);
      allow create: if isWorkspaceUser() && (request.resource.data.createdBy == request.auth.uid || request.resource.data.ownerId == request.auth.uid);
      allow update: if hasWriteAccess(resource.data) || (isWorkspaceUser() && resource.data.assignedTo == request.auth.uid);
      allow delete: if isAdmin() || (isWorkspaceUser() && (resource.data.createdBy == request.auth.uid || resource.data.ownerId == request.auth.uid));
    }

    // Projects Collection
    match /projects/{projectId} {
      allow read: if hasReadAccess(resource.data);
      allow create: if isWorkspaceUser() && (request.resource.data.ownerId == request.auth.uid || request.resource.data.createdBy == request.auth.uid);
      allow update: if hasWriteAccess(resource.data);
      allow delete: if isAdmin() || (isWorkspaceUser() && (resource.data.ownerId == request.auth.uid || resource.data.createdBy == request.auth.uid));
    }

    // Meetings Collection
    match /meetings/{meetingId} {
      allow read: if hasReadAccess(resource.data);
      allow create: if isWorkspaceUser() && request.resource.data.ownerId == request.auth.uid;
      allow update: if hasWriteAccess(resource.data);
      allow delete: if isAdmin() || (isWorkspaceUser() && resource.data.ownerId == request.auth.uid);
    }

    // Clients Collection
    match /clients/{clientId} {
      allow read: if hasReadAccess(resource.data);
      allow create: if isWorkspaceUser() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin() || (isWorkspaceUser() && resource.data.ownerId == request.auth.uid);
    }

    // Follow-ups Collection
    match /followUps/{followUpId} {
      allow read: if hasReadAccess(resource.data);
      allow create: if isWorkspaceUser() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin() || (isWorkspaceUser() && resource.data.ownerId == request.auth.uid);
    }

    // Inbox Collection
    match /inbox/{inboxId} {
      allow read: if isWorkspaceUser();
      allow create: if isWorkspaceUser() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin() || (isWorkspaceUser() && resource.data.createdBy == request.auth.uid);
    }

    // Knowledge Collection
    match /knowledge/{knowledgeId} {
      allow read: if isWorkspaceUser();
      allow create: if isWorkspaceUser();
      allow update, delete: if isWorkspaceUser();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isWorkspaceUser() && resource.data.userId == request.auth.uid;
      allow create: if isWorkspaceUser();
      allow update, delete: if isWorkspaceUser() && resource.data.userId == request.auth.uid;
    }

    // Activity Logs Collection
    match /activityLogs/{activityId} {
      allow read: if isWorkspaceUser();
      allow create: if isWorkspaceUser() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Recurring Templates Collection
    match /recurringMeetingTemplates/{templateId} {
      allow read: if isWorkspaceUser();
      allow create: if isWorkspaceUser() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin() || (isWorkspaceUser() && resource.data.ownerId == request.auth.uid);
    }

    match /recurringTaskTemplates/{templateId} {
      allow read: if isWorkspaceUser();
      allow create: if isWorkspaceUser() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin() || (isWorkspaceUser() && resource.data.ownerId == request.auth.uid);
    }

    // User Private Subcollections
    match /users/{userId}/private/{docId} {
      allow read, write: if isSelf(userId) || isAdmin();
    }

    match /users/{userId}/conversations/{conversationId} {
      allow read, write: if isSelf(userId) || isAdmin();
    }

    match /users/{userId}/memories/{memoryId} {
      allow read, write: if isSelf(userId) || isAdmin();
    }
  }
}
