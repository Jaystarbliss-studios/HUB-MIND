{
  "manifest_version": 3,
  "name": "Hub-Mind Jess Browser Bridge",
  "version": "1.0.0",
  "description": "Lets the installed Hub-Mind desktop app control the user's real Chrome tabs through an authenticated native-messaging bridge.",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  }
}
